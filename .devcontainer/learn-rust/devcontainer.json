// Dev container for the learn-rust course. Open the repository in VS Code and
// choose "Reopen in Container" -> "Learn Rust (kuksa-databroker course)".
// Format reference: https://aka.ms/devcontainer.json
{
	"name": "Learn Rust (kuksa-databroker course)",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"remoteUser": "vscode",
	// Build output lives in named volumes: much faster than compiling into a
	// bind-mounted folder on macOS/Windows hosts, and survives rebuilds.
	"mounts": [
		{
			"source": "kuksa-learn-rust-target",
			"target": "${containerWorkspaceFolder}/learn-rust/target",
			"type": "volume"
		},
		{
			"source": "kuksa-databroker-target",
			"target": "${containerWorkspaceFolder}/target",
			"type": "volume"
		}
	],
	"postCreateCommand": "bash .devcontainer/learn-rust/post-create.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"rust-lang.rust-analyzer",
				"tamasfe.even-better-toml",
				"vadimcn.vscode-lldb",
				"zxh404.vscode-proto3"
			],
			"settings": {
				// learn-rust is its own Cargo workspace; tell rust-analyzer
				// about both it and the databroker workspace.
				"rust-analyzer.linkedProjects": [
					"learn-rust/Cargo.toml",
					"Cargo.toml"
				],
				"rust-analyzer.check.command": "clippy",
				"files.watcherExclude": {
					"**/target/**": true
				}
			}
		}
	},
	"hostRequirements": {
		"cpus": 4,
		"memory": "8gb"
	}
}
